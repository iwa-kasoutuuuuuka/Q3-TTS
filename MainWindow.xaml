<Window x:Class="Q3TTS.Native.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Q3-TTS American English Edition" Height="740" Width="1150" Icon="assets/icon.png"
        Background="{StaticResource BackgroundBrush}"
        WindowStyle="None" AllowsTransparency="True"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">

    <Window.Resources>
        <SolidColorBrush x:Key="BackgroundBrush" Color="#121212"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#3B82F6"/>
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#2563EB"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#10B981"/>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="8" CornerRadius="15" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="1" CornerRadius="15" Background="{StaticResource BackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom Window Titlebar -->
            <Border Grid.Row="0" Background="#18181B" CornerRadius="14,14,0,0" Padding="20,10"
                    Cursor="SizeAll" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Q3-TTS" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,10,0"/>
                        <TextBlock Text="| Qwen3-TTS American English Edition" FontSize="14" Foreground="Gray" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="MinimizeBtn" Content="" FontFamily="Segoe MDL2 Assets" Background="Transparent" Foreground="Gray" BorderThickness="0" Width="40" Height="40" Click="MinimizeButton_Click" ToolTip="Minimize"/>
                        <Button x:Name="MaximizeBtn" Content="" FontFamily="Segoe MDL2 Assets" Background="Transparent" Foreground="Gray" BorderThickness="0" Width="40" Height="40" Click="MaximizeButton_Click" ToolTip="Maximize"/>
                        <Button x:Name="ExitBtn" Content="" FontFamily="Segoe MDL2 Assets" Background="Transparent" Foreground="White" BorderThickness="0" Width="40" Height="40" Click="ExitButton_Click" ToolTip="Exit"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content Area -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Sidebar Settings -->
                <Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="0,0,0,14" Padding="20,15">
                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- Logo Header -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                    <Image Source="assets/icon.png" Width="42" Height="42" Margin="0,0,10,0" Stretch="UniformToFill">
                                        <Image.Clip>
                                            <RectangleGeometry Rect="0,0,42,42" RadiusX="8" RadiusY="8"/>
                                        </Image.Clip>
                                    </Image>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Qwen3-TTS Model" FontSize="15" FontWeight="Bold" Foreground="White"/>
                                        <TextBlock x:Name="BackendStatusText" Text="CUDA GPU Accelerated" FontSize="11" Foreground="{StaticResource AccentBrush}"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Model Size Selector -->
                                <TextBlock Text="Model Selection / モデル選択" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,8"/>
                                <ComboBox x:Name="ModelCombo" SelectedIndex="0" Margin="0,0,0,15" Height="35" SelectionChanged="ModelCombo_SelectionChanged">
                                    <ComboBoxItem Content="Qwen3-TTS 1.7B (High Quality / 高音質)"/>
                                    <ComboBoxItem Content="Qwen3-TTS 0.6B (Fast &amp; Light / 軽量高速)"/>
                                </ComboBox>

                                <!-- Synthesis Mode Tab -->
                                <TextBlock Text="Voice Mode / 音声モード" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,8"/>
                                <ComboBox x:Name="ModeCombo" SelectedIndex="0" Margin="0,0,0,15" Height="35" SelectionChanged="ModeCombo_SelectionChanged">
                                    <ComboBoxItem Content="Voice Prompt (US Reference Audio / 参照音声)"/>
                                    <ComboBoxItem Content="Voice Design (Text Description / 音声指示)"/>
                                </ComboBox>

                                <!-- Voice Prompt Reference Audio Selector -->
                                <StackPanel x:Name="VoicePromptPanel" Margin="0,0,0,15">
                                    <TextBlock Text="US Voice Prompt / 参照音声WAV" Foreground="White" Margin="0,0,0,5"/>
                                    <Grid AllowDrop="True" PreviewDragOver="VoicePrompt_DragOver" Drop="VoicePrompt_Drop">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="VoicePromptPathText" IsReadOnly="True" Text="default_voice_us_narrator.wav" Height="32" Foreground="LightGray" VerticalContentAlignment="Center" Padding="5,0"/>
                                        <Button x:Name="SelectVoiceButton" Grid.Column="1" Content="Browse" Width="60" Margin="5,0,0,0" Click="SelectVoice_Click"/>
                                    </Grid>
                                </StackPanel>

                                <!-- Voice Design Text Prompt Panel -->
                                <StackPanel x:Name="VoiceDesignPanel" Margin="0,0,0,15" Visibility="Collapsed">
                                    <TextBlock Text="Voice Design Prompt / 音声指示プロンプト" Foreground="White" Margin="0,0,0,5"/>
                                    <TextBox x:Name="VoiceDesignText" Text="A clear, articulate, and professional American English corporate training narrator speaking calmly and confidently." Height="50" TextWrapping="Wrap" AcceptsReturn="True" Foreground="White" Background="#2A2A2A" BorderBrush="#444" Padding="5"/>
                                </StackPanel>

                                <TextBlock Text="Speech Parameters / 音声パラメータ設定" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,5,0,8"/>
                                <Border Height="1" Background="#333" Margin="0,0,0,12"/>

                                <!-- Speed Slider -->
                                <DockPanel Margin="0,0,0,12">
                                    <TextBlock Text="Speed (WSOLA) / 話速" Foreground="White" DockPanel.Dock="Top" Margin="0,0,0,4"/>
                                    <TextBox x:Name="SpeedText" Text="{Binding ElementName=SpeedSlider, Path=Value, Mode=TwoWay, StringFormat={}{0:F2}}" Foreground="{StaticResource PrimaryBrush}" DockPanel.Dock="Right" Width="45" Height="24" TextAlignment="Right" VerticalContentAlignment="Center" Background="#252525" BorderBrush="#444"/>
                                    <Slider x:Name="SpeedSlider" Minimum="0.5" Maximum="2.0" Value="0.95" TickFrequency="0.05" IsSnapToTickEnabled="True"/>
                                </DockPanel>

                                <!-- Exaggeration Slider -->
                                <DockPanel Margin="0,0,0,12">
                                    <TextBlock Text="Exaggeration / 抑揚・感情表現" Foreground="White" DockPanel.Dock="Top" Margin="0,0,0,4"/>
                                    <TextBox x:Name="ExaggerationText" Text="{Binding ElementName=ExaggerationSlider, Path=Value, Mode=TwoWay, StringFormat={}{0:F2}}" Foreground="{StaticResource PrimaryBrush}" DockPanel.Dock="Right" Width="45" Height="24" TextAlignment="Right" VerticalContentAlignment="Center" Background="#252525" BorderBrush="#444"/>
                                    <Slider x:Name="ExaggerationSlider" Minimum="0" Maximum="1" Value="0.10" TickFrequency="0.01" IsSnapToTickEnabled="True"/>
                                </DockPanel>

                                <!-- Stability / Temperature Slider -->
                                <DockPanel Margin="0,0,0,12">
                                    <TextBlock Text="Stability (Temperature) / 発音安定性" Foreground="White" DockPanel.Dock="Top" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TemperatureText" Text="{Binding ElementName=TemperatureSlider, Path=Value, Mode=TwoWay, StringFormat={}{0:F2}}" Foreground="{StaticResource PrimaryBrush}" DockPanel.Dock="Right" Width="45" Height="24" TextAlignment="Right" VerticalContentAlignment="Center" Background="#252525" BorderBrush="#444"/>
                                    <Slider x:Name="TemperatureSlider" Minimum="0.1" Maximum="1.2" Value="0.40" TickFrequency="0.01" IsSnapToTickEnabled="True"/>
                                </DockPanel>

                                <!-- CFG / Pace Slider -->
                                <DockPanel Margin="0,0,0,12">
                                    <TextBlock Text="CFG / Pace Weight / テキスト追従度" Foreground="White" DockPanel.Dock="Top" Margin="0,0,0,4"/>
                                    <TextBox x:Name="CfgWeightText" Text="{Binding ElementName=CfgWeightSlider, Path=Value, Mode=TwoWay, StringFormat={}{0:F2}}" Foreground="{StaticResource PrimaryBrush}" DockPanel.Dock="Right" Width="45" Height="24" TextAlignment="Right" VerticalContentAlignment="Center" Background="#252525" BorderBrush="#444"/>
                                    <Slider x:Name="CfgWeightSlider" Minimum="0" Maximum="1" Value="0.45" TickFrequency="0.01" IsSnapToTickEnabled="True"/>
                                </DockPanel>

                                <!-- Repetition Penalty Slider -->
                                <DockPanel Margin="0,0,0,12">
                                    <TextBlock Text="Repetition Penalty / 繰り返し抑止" Foreground="White" DockPanel.Dock="Top" Margin="0,0,0,4"/>
                                    <TextBox x:Name="RepetitionPenaltyText" Text="{Binding ElementName=RepetitionPenaltySlider, Path=Value, Mode=TwoWay, StringFormat={}{0:F2}}" Foreground="{StaticResource PrimaryBrush}" DockPanel.Dock="Right" Width="45" Height="24" TextAlignment="Right" VerticalContentAlignment="Center" Background="#252525" BorderBrush="#444"/>
                                    <Slider x:Name="RepetitionPenaltySlider" Minimum="1.0" Maximum="2.0" Value="1.30" TickFrequency="0.01" IsSnapToTickEnabled="True"/>
                                </DockPanel>

                                <!-- Debug STT Verification Checkbox -->
                                <CheckBox x:Name="DebugSttCheckBox" Content="Output Whisper STT verification log (.debug.txt) / 文字起こし検証ログ出力" Foreground="LightGray" Margin="0,5,0,15" ToolTip="Transcribes generated WAV audio with Whisper STT and logs accuracy comparison."/>

                                <!-- Status Info -->
                                <StackPanel VerticalAlignment="Bottom" Margin="0,10,0,0">
                                    <TextBlock x:Name="StatusText" Text="Ready" Foreground="Orange" FontSize="12" TextWrapping="Wrap"/>
                                    <ProgressBar x:Name="StatusProgress" Height="5" Margin="0,8,0,0" Value="100" Background="#222" Foreground="{StaticResource PrimaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Right Main Text Area -->
                <Grid Grid.Column="1" Margin="25,15,25,25">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,10">
                        <TextBlock x:Name="CharCountText" Text="0 characters" Foreground="Gray" FontSize="14"/>
                    </StackPanel>

                    <!-- Text Input Box -->
                    <Border Grid.Row="1" Background="#222" CornerRadius="10" Padding="15" BorderBrush="#333" BorderThickness="1">
                        <Grid>
                            <TextBox x:Name="InputTextBox" Background="Transparent" Foreground="White" BorderThickness="0" 
                                     FontSize="19" TextWrapping="Wrap" AcceptsReturn="True" 
                                     VerticalScrollBarVisibility="Auto" TextChanged="InputTextBox_TextChanged"
                                     AllowDrop="True" PreviewDragOver="InputTextBox_DragOver" Drop="InputTextBox_Drop"
                                     CaretBrush="White" SelectionBrush="{StaticResource PrimaryBrush}"/>
                            
                            <TextBlock x:Name="WatermarkText" Text="Type or paste English text here, or drag &amp; drop a .txt/.md file..." 
                                       Foreground="Gray" FontSize="19" IsHitTestVisible="False" VerticalAlignment="Top" Margin="2,2,0,0" Opacity="0.5">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ElementName=InputTextBox, Path=Text}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ElementName=InputTextBox, Path=Text}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!-- Action Buttons -->
                    <Grid Grid.Row="2" Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="ClearButton" Content="Clear / クリア" Background="Transparent" Foreground="Gray" BorderThickness="1" BorderBrush="#444" Width="105" Height="50" Margin="0,0,10,0" Click="ClearButton_Click"/>

                        <Button x:Name="PlayButton" Grid.Column="2" Content="Play Speech / 再生" Width="200" Height="52" FontSize="16" FontWeight="Bold" Background="{StaticResource PrimaryBrush}" Foreground="White" Margin="0,0,12,0" Click="PlayButton_Click"/>
                        <Button x:Name="SaveButton" Grid.Column="3" Content="Save WAV / 保存" Width="140" Height="52" FontSize="15" Background="#333" Foreground="White" Click="SaveButton_Click"/>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
